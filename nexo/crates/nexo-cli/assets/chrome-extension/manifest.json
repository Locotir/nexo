{
  "manifest_version": 3,
  "name": "nexo browser",
  "version": "0.2.0",
  "description": "Lets the nexo terminal agent work in this Chrome, only after you click Allow. Talks only to the local nexo native host.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "nexo browser"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ]
}
